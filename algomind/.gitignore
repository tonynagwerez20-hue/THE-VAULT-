# Python
__pycache__/
*.py[cod]
*.pyo
*.so
.eggs/
build/
dist/
*.egg-info/
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
nox/

# Config / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
credentials.yaml

# Data — never commit raw/private datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/fixtures/*
!data/fixtures/.gitkeep
tests/fixtures/*.csv
tests/fixtures/*.jsonl

# Logs
logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~