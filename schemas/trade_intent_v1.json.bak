{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "algomind/trade_intent_v1",
  "title": "AlgoMind TradeIntent v1",
  "description": "Canonical trade intent produced by the MQL5 decision gate.",
  "type": "object",
  "required": [
    "intent_id", "schema_version", "strategy_version", "feature_version",
    "symbol", "direction", "timestamp", "expiry",
    "entry_reference", "stop", "target",
    "score", "confidence", "regime", "hypothesis",
    "risk_allocation", "data_quality"
  ],
  "properties": {
    "intent_id":        { "type": "integer", "description": "Unique decision ID (TimeCurrent * 1000 + sequence)" },
    "schema_version":   { "const": 100, "description": "Contract version = 100 for v1.0.0" },
    "strategy_version": { "type": "integer", "minimum": 1 },
    "feature_version":  { "type": "integer", "minimum": 1 },
    "model_version":    { "type": "integer", "minimum": 0, "description": "0 when ML gate is not active" },
    "symbol":           { "type": "string" },
    "direction":        { "enum": [1, -1], "description": "1 = long, -1 = short" },
    "timestamp":        { "type": "integer", "description": "Unix seconds at intent creation" },
    "expiry":           { "type": "integer", "description": "Unix seconds after which the intent is stale" },
    "entry_reference":  { "type": "number" },
    "stop":             { "type": "number" },
    "target":           { "type": "number" },
    "score":            { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence":       { "type": "number", "minimum": 0, "maximum": 1 },
    "regime":           { "type": "integer", "minimum": 0, "maximum": 7, "description": "ENUM_REGIME value" },
    "hypothesis":       { "type": "integer", "minimum": 0, "maximum": 2, "description": "ENUM_HYPOTHESIS value" },
    "reason_codes":     { "type": "string" },
    "risk_allocation":  { "type": "number", "description": "Risk percentage requested" },
    "data_quality":     { "type": "integer", "description": "Bitmask of DQ_* flags" }
  },
  "additionalProperties": false
}
